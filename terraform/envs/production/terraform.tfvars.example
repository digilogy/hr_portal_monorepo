# =============================================================================
# Copy to terraform.tfvars and fill in the values marked REQUIRED.
# terraform.tfvars is gitignored — never commit it.
# =============================================================================

aws_region = "ap-south-1"
ses_region = "ap-south-1"

project            = "timesheet"
environment        = "prod"
custom_name_prefix = "timesheet" # All AWS resources will be prefixed with 'timesheet'

# --- DNS (hosted zone must already exist in Route 53) ---
root_domain     = "cgworkflow.com"               # Hosted zone in Route 53
api_domain      = "api.timesheet.cgworkflow.com" # API domain
frontend_domain = "timesheet.cgworkflow.com"     # Frontend domain
wildcard_domain = "*.timesheet.cgworkflow.com"   # Wildcard SAN

# --- REQUIRED: application settings ---
allowed_origins = "https://timesheet.cgworkflow.com"
ses_from_email  = "support@cgworkflow.com"
admin_user      = "admin@cgworkflow.com"
admin_pin       = "CHANGE-ME"
s3_bucket_name  = "hr-portal-prod-uploads-CHANGE-ME" # globally unique

# --- REQUIRED: operations ---
alarm_email = "ops@cgworkflow.com"

# --- Serverless Sizing (defaults are cost-effective for HR-portal scale) ---
# aurora_min_capacity       = 0.5
# aurora_max_capacity       = 4.0
# aurora_instances_count    = 1
# redis_max_data_storage_gb = 5
# redis_max_ecpu_per_second = 5000
# api_cpu                   = 512
# api_memory                = 1024
# api_min_tasks             = 2
# api_max_tasks             = 6
# mail_worker_desired_count = 1
# nat_gateway_count         = 1

