// Enterprise Prisma Schema optimized for MySQL / MariaDB & High Concurrency (10,000+ Users)
// Datasource & Generator Configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// Enums
// --------------------------------------------------------

enum UserRole {
  ADMIN    @map("admin")
  HRBP     @map("hrbp")
  MANAGER  @map("manager")
  EMPLOYEE @map("employee")
}

enum EmailStatus {
  QUEUED     @map("queued")
  PROCESSING @map("processing")
  SENT       @map("sent")
  FAILED     @map("failed")
}

enum EmailType {
  PIN_SETUP @map("pin_setup")
  PIN_RESET @map("pin_reset")
}

// --------------------------------------------------------
// Models
// --------------------------------------------------------

model User {
  id        Int      @id @default(autoincrement())
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  email     String   @unique
  phone     String?
  pin       String?  // Hashed PIN (bcrypt)
  role      UserRole @default(EMPLOYEE)
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")

  timesheets Timesheet[]

  @@index([email])
  @@index([role])
  @@map("user")
}

model Timesheet {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("userId")
  date       String   @db.VarChar(10) // ISO Date string YYYY-MM-DD
  slots      Json     // Array of TimesheetSlots
  totalHours Float    @default(0) @map("totalHours")
  status     String   @default("saved") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("createdAt")
  updatedAt  DateTime @default(now()) @updatedAt @map("updatedAt")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Compound Unique Index to enforce single timesheet per user per day
  @@unique([userId, date])
  // High-performance compound indexes for dashboard queries & team reports under 10k concurrent users
  @@index([userId, date])
  @@index([userId, status])
  @@index([date, status])
  @@index([date])
  @@map("timesheet")
}

model EmployeeData {
  id                      Int      @id @default(autoincrement())
  employmentStatus        String?  @map("employmentStatus")
  employeeId              String?  @map("employeeId")
  fullName                String?  @map("fullName")
  jobTitle                String?  @map("jobTitle")
  department              String?
  subDepartment           String?  @map("subDepartment")
  directManagerEmployeeId String?  @map("directManagerEmployeeId")
  directManagerName       String?  @map("directManagerName")
  hrbpEmployeeId          String?  @map("hrbpEmployeeId")
  hrbpName                String?  @map("hrbpName")
  hodEmployeeId           String?  @map("hodEmployeeId")
  hodEmployeeName         String?  @map("hodEmployeeName")
  officialEmailId         String?  @map("officialEmailId")
  officeMobileNumber      String?  @map("officeMobileNumber")
  createdAt               DateTime @default(now()) @map("createdAt")
  updatedAt               DateTime @default(now()) @updatedAt @map("updatedAt")

  // Indexes for high throughput roster, hierarchy & email validation lookups
  @@index([officialEmailId])
  @@index([employeeId])
  @@index([directManagerEmployeeId])
  @@index([hrbpEmployeeId])
  @@index([hodEmployeeId])
  @@index([department, subDepartment])
  @@index([employmentStatus])
  @@map("employee_data")
}

model EmailLog {
  id           String      @id @default(dbgenerated("gen_random_uuid()"))
  toEmail      String      @map("toEmail")
  subject      String
  emailType    EmailType   @map("emailType")
  payload      Json?
  status       EmailStatus @default(QUEUED)
  attemptCount Int         @default(0) @map("attemptCount")
  maxAttempts  Int         @default(3) @map("maxAttempts")
  errorMessage String?     @map("errorMessage") @db.Text
  sesMessageId String?     @map("sesMessageId")
  sentAt       DateTime?   @map("sentAt")
  nextRetryAt  DateTime?   @map("nextRetryAt")
  createdAt    DateTime    @default(now()) @map("createdAt")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updatedAt")

  @@index([toEmail, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("email_log")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime @map("expiresAt")
  createdAt DateTime @default(now()) @map("createdAt")

  @@index([email, expiresAt])
  @@map("otp")
}

model UploadJob {
  id           String   @id @default(uuid())
  originalName String   @map("originalName")
  storedPath   String   @map("storedPath")
  status       String   @default("queued")
  totalRows    Int      @default(0) @map("totalRows")
  processed    Int      @default(0)
  successCount Int      @default(0) @map("successCount")
  errorCount   Int      @default(0) @map("errorCount")
  errorMessage String?  @map("errorMessage") @db.Text
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @default(now()) @updatedAt @map("updatedAt")

  @@map("upload_job")
}

model UploadLog {
  id          Int      @id @default(autoincrement())
  jobId       String   @map("jobId")
  employeeId  String?  @map("employeeId")
  email       String?
  action      String?
  changes     Json?
  details     String?  @db.Text
  performedBy String?  @map("performedBy")
  rowIndex    Int?     @map("rowIndex")
  status      String?
  message     String?  @db.Text
  payload     Json?
  createdAt   DateTime @default(now()) @map("createdAt")

  @@index([jobId])
  @@map("upload_log")
}
